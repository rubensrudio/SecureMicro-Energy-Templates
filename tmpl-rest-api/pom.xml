<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ================================================================
         tmpl-rest-api — Spring Boot WebFlux REST API template
         Inherits version management from the root BOM.

         This module is the main deliverable of TASK-013.  It wires
         the four shared-* libraries together with the WebFlux runtime
         and exposes a skeleton application that compiles cleanly.

         Subsequent tasks (TASK-014 through TASK-021) will add:
           - application.yml with Vault imports (TASK-014)
           - WebFlux controllers (TASK-015)
           - Actuator / health configuration (TASK-016)
           - Security error handlers (TASK-017)
           - Integration tests (TASK-018)
           - Dockerfile + Jib + CycloneDX (TASK-019)
           - Threat model and control-mapping (TASK-020, TASK-021)

         groupId    : com.securemicro
         artifactId : tmpl-rest-api
         Package    : com.securemicro.tmpl.restapi
         ================================================================ -->

    <parent>
        <groupId>com.securemicro</groupId>
        <artifactId>secure-micro-energy-templates</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>tmpl-rest-api</artifactId>
    <packaging>jar</packaging>
    <name>SecureMicro :: Template REST API</name>
    <description>
        Production-grade Spring Boot WebFlux REST API template with full
        security controls: Keycloak OIDC, HashiCorp Vault secrets, structured
        JSON logging, Micrometer metrics, OTel tracing, SBOM generation and
        reproducible container builds.
        Phase 1 - implementation in TASK-013 through TASK-021.
    </description>

    <!-- ================================================================
         Dependencies
         All versions are managed by the root BOM; child modules declare
         only groupId + artifactId (plus scope/version when required).
         ================================================================ -->
    <dependencies>

        <!-- ============================================================
             Internal shared libraries — resolved as Maven local artifacts
             installed by the reactor build order declared in the root POM.
             The root dependencyManagement block pins these to
             ${project.version}, so no version literal is needed here.
             ============================================================ -->

        <!-- shared-controls: SecurityHeadersFilter (WebFilter) and
             GlobalExceptionHandler.  Both carry @ConditionalOnMissingBean
             so this module may override them in later tasks without conflict.
             CONTROL: RN-10 -->
        <dependency>
            <groupId>com.securemicro</groupId>
            <artifactId>shared-controls</artifactId>
            <!-- version managed by root dependencyManagement -->
        </dependency>

        <!-- shared-observability: structured JSON logging (Logstash),
             Micrometer / Prometheus registry, and OpenTelemetry tracing.
             CONTROL: INI-16 | INI-18 | INI-19 | INI-21 -->
        <dependency>
            <groupId>com.securemicro</groupId>
            <artifactId>shared-observability</artifactId>
            <!-- version managed by root dependencyManagement -->
        </dependency>

        <!-- shared-identity: IdentitySecurityConfiguration with
             @EnableWebFluxSecurity, ReactiveJwtDecoder (Keycloak JWKS),
             and role-based authorization.
             Requires KEYCLOAK_ISSUER_URI and JWT_AUDIENCE env vars at runtime.
             CONTROL: INI-04 | INI-05 | INI-06 | INI-07 | RN-02 -->
        <dependency>
            <groupId>com.securemicro</groupId>
            <artifactId>shared-identity</artifactId>
            <!-- version managed by root dependencyManagement -->
        </dependency>

        <!-- shared-secrets: Spring Cloud Vault bootstrap (ConfigData API),
             KV v2 property source, and secret masking in logs.
             Disabled via spring.cloud.vault.enabled=false in local / test profiles.
             CONTROL: RN-01 | INI-11 | INI-12 -->
        <dependency>
            <groupId>com.securemicro</groupId>
            <artifactId>shared-secrets</artifactId>
            <!-- version managed by root dependencyManagement -->
        </dependency>

        <!-- ============================================================
             Spring Boot Starter WebFlux — reactive HTTP server (Netty +
             Project Reactor).  Required because this service is built on
             the reactive stack (PRD section 5.2 mandates WebFlux).
             Version managed by parent spring-boot-dependencies BOM.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
            <!-- version managed by parent BOM -->
        </dependency>

        <!-- ============================================================
             Spring Boot Starter Actuator — health probes, readiness /
             liveness endpoints, Micrometer metrics export.
             CONTROL: RN-05 | INI-18 | INI-20
             Version managed by parent spring-boot-dependencies BOM.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <!-- version managed by parent BOM -->
        </dependency>

        <!-- ============================================================
             SpringDoc OpenAPI WebFlux UI (2.x) — generates an OpenAPI 3
             specification and serves Swagger UI at /swagger-ui.html.
             Compatible with Spring Boot 3.3.x.
             Version pinned in root POM property: springdoc-openapi.version
             ============================================================ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <!-- ============================================================
             TEST SCOPE
             ============================================================ -->

        <!-- Spring Boot Test — JUnit 5, Mockito, AssertJ, WebTestClient,
             @SpringBootTest slice support. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Reactor Test — StepVerifier for reactive pipeline assertions. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security Test — mockJwt(), SecurityMockServerConfigurers.
             Used in TASK-018 integration tests. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WireMock Standalone — mocks Keycloak JWKS and OIDC discovery
             endpoints in integration tests without a live Keycloak instance.
             Version managed by root dependencyManagement (wiremock.version). -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ================================================================
         Properties
         Reproducible build: pinning the output timestamp guarantees that
         the JAR manifest and archive entries have a deterministic timestamp,
         which is a prerequisite for producing the same digest across builds.
         AC INI-24 / CONTROL: RN-09
         Override in CI via -Dproject.build.outputTimestamp=<ISO8601>.
         ================================================================ -->
    <properties>
        <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <!-- ================================================================
         Build
         ================================================================ -->
    <build>
        <plugins>

            <!-- Maven Surefire — explicit argLine to enable Byte Buddy
                 instrumentation on Java 25+ (Byte Buddy officially supports
                 up to Java 23; experimental flag unlocks newer runtimes).
                 Required for @MockBean + @WebFluxTest slice tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dnet.bytebuddy.experimental=true -Dotel.sdk.disabled=true</argLine>
                    <!-- Restrict Spring Boot config search to classpath only during tests.
                         Prevents tmpl-rest-api/config/application.yml (external deploy config
                         with vault:// imports) from being loaded via the file:./config/
                         search path. All test overrides go through src/test/resources. -->
                    <systemPropertyVariables>
                        <spring.config.location>classpath:/</spring.config.location>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Spring Boot Maven Plugin — repackages the JAR into an
                 executable fat-JAR with embedded Netty server.
                 Plugin version managed by root pluginManagement. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 CycloneDX Maven Plugin — generates SBOM in CycloneDX format.
                 Bound to the package phase so that every `mvn package` run
                 produces a SBOM artifact at target/bom.xml (and bom.json).
                 Required by EO 14028 for software supply chain provenance.
                 Version managed by root pluginManagement.
                 CONTROL: RN-03 — dependencies verified and declared in SBOM
                 CONTROL: INI-22 | INI-23
                 ============================================================ -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <!-- version managed by root pluginManagement -->
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <projectType>application</projectType>
                    <schemaVersion>1.4</schemaVersion>
                    <includeBomSerialNumber>true</includeBomSerialNumber>
                    <includeCompileScope>true</includeCompileScope>
                    <includeTestScope>false</includeTestScope>
                    <includeRuntimeScope>true</includeRuntimeScope>
                </configuration>
            </plugin>

            <!-- ============================================================
                 Jib Maven Plugin — builds a reproducible OCI container image
                 without a local Docker daemon.  Jib is the PRIMARY container
                 build mechanism for this template; the Dockerfile at
                 tmpl-rest-api/build/Dockerfile is an alternative reference.
                 Version managed by root pluginManagement.
                 CONTROL: RN-09 — reproducible digest via fixed outputTimestamp
                 CONTROL: RN-03 — SBOM digest is the same across identical builds
                 ============================================================ -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <!-- version managed by root pluginManagement -->
                <configuration>
                    <from>
                        <!-- Minimal JRE-only Alpine base; matches Stage 2 of the
                             reference Dockerfile.  CONTROL: RN-09 -->
                        <image>eclipse-temurin:17-jre-alpine</image>
                    </from>
                    <to>
                        <image>securemicro/tmpl-rest-api</image>
                        <tags>
                            <tag>${project.version}</tag>
                            <tag>latest</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.securemicro.tmpl.restapi.TmplRestApiApplication</mainClass>
                        <ports>
                            <port>8080</port>
                        </ports>
                        <!-- Reproducible build: reuses project.build.outputTimestamp
                             (2026-01-01T00:00:00Z) so two builds of the same source
                             produce identical image digests. AC INI-24 / CONTROL: RN-09
                             CI override for build provenance timestamps:
                             -Djib.container.creationTime=$(date -u +%Y-%m-%dT%H:%M:%SZ) -->
                        <creationTime>${project.build.outputTimestamp}</creationTime>
                        <!-- Non-root user: UID/GID 65532 ("nonroot" convention)
                             matches the adduser step in the reference Dockerfile.
                             CONTROL: RN-09 -->
                        <user>65532:65532</user>
                    </container>
                    <!-- CONTROL: RN-03 — reproducible digest: when combined with
                         <project.build.outputTimestamp>, Jib produces a
                         content-addressable image that is verifiable via digest. -->
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>
