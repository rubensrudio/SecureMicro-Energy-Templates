# =============================================================================
# tmpl-rest-api — Multi-Stage Dockerfile
#
# NOTE: Jib is the PRIMARY container build mechanism for this template.
#       (see jib-maven-plugin configuration in pom.xml)
#       This Dockerfile is an ALTERNATIVE REFERENCE for environments that
#       require a Docker-daemon-based build (e.g., air-gapped CI, custom
#       base image patching, or manual inspection of layers).
#
# Usage (alternative/reference build):
#   docker build -f tmpl-rest-api/build/Dockerfile \
#                --build-arg JAR_FILE=target/tmpl-rest-api-0.1.0-SNAPSHOT.jar \
#                -t securemicro/tmpl-rest-api:latest .
#
# Reproducibility note:
#   For a reproducible build, set SOURCE_DATE_EPOCH before calling docker build:
#     export SOURCE_DATE_EPOCH=$(date -d "2026-01-01T00:00:00Z" +%s)
#   Then pass --build-arg SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH
#   The JAR itself must be built with the outputTimestamp property pinned
#   (see pom.xml <project.build.outputTimestamp>).
#
# Read-only filesystem:
#   This image is designed to run with --read-only.  The application writes
#   only to stdout/stderr (logs) and to /tmp (Spring temporary files).
#   Run with:
#     docker run --read-only --tmpfs /tmp ... securemicro/tmpl-rest-api:latest
#
# CONTROL: RN-03 — all build dependencies are declared and pinned; SBOM is
#           generated by cyclonedx-maven-plugin during mvn package (see pom.xml).
# CONTROL: RN-09 — eclipse-temurin:17-jre-alpine is a minimal, distroless-like
#           base image; only the JRE (not JDK) is present at runtime.
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — Build
# Uses the official Maven + Eclipse Temurin 17 Alpine image so the build
# environment matches the declared <java.version>17</java.version> in pom.xml.
# The Maven local repository is cached in a separate layer to speed up
# subsequent builds when only source files change.
# -----------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-17-alpine AS build

WORKDIR /workspace

# Copy only the aggregator POM and module POMs first to leverage Docker layer
# caching: if only source code changes, the dependency-download layer is reused.
COPY pom.xml                        ./pom.xml
COPY shared-controls/pom.xml        ./shared-controls/pom.xml
COPY shared-observability/pom.xml   ./shared-observability/pom.xml
COPY shared-identity/pom.xml        ./shared-identity/pom.xml
COPY shared-secrets/pom.xml         ./shared-secrets/pom.xml
COPY tmpl-rest-api/pom.xml          ./tmpl-rest-api/pom.xml

# Pre-fetch dependencies (offline-ready layer).
# -B = batch mode (no interactive prompts), -q = quiet (reduce noise).
RUN mvn -B -q dependency:go-offline -DexcludeArtifactIds="" 2>/dev/null || true

# Copy all source trees (invalidates layer only when sources change).
COPY shared-controls/src        ./shared-controls/src
COPY shared-observability/src   ./shared-observability/src
COPY shared-identity/src        ./shared-identity/src
COPY shared-secrets/src         ./shared-secrets/src
COPY tmpl-rest-api/src          ./tmpl-rest-api/src

# Build the full reactor, skipping tests (tests run in CI before docker build).
# CycloneDX SBOM is generated here as a side effect of the package phase.
# CONTROL: RN-03 — SBOM artifact is produced at /workspace/tmpl-rest-api/target/bom.xml
RUN mvn -B -pl tmpl-rest-api -am package -DskipTests

# -----------------------------------------------------------------------------
# Stage 2 — Runtime
# eclipse-temurin:17-jre-alpine contains only the JRE (no compiler, no tools).
# Alpine base keeps the image small and reduces attack surface.
# CONTROL: RN-09 — minimal base image; no build toolchain at runtime.
# -----------------------------------------------------------------------------
FROM eclipse-temurin:17-jre-alpine AS runtime

# Security hardening: create a dedicated non-root user and group.
# UID/GID 65532 matches the "nonroot" convention used by distroless and Jib
# (see jib-maven-plugin <user>65532:65532</user> in pom.xml) so that images
# built via Jib and via this Dockerfile are consistent.
RUN addgroup -S -g 65532 appgroup && \
    adduser  -S -u 65532 -G appgroup -H -D appuser

WORKDIR /app

# Copy the fat-JAR produced by the build stage.
# The Spring Boot Maven Plugin repackages the JAR as an executable fat-JAR
# with embedded Netty server.
COPY --from=build /workspace/tmpl-rest-api/target/tmpl-rest-api-*.jar app.jar

# Ensure the JAR is owned by the non-root user (read-only in --read-only mode).
RUN chown appuser:appgroup app.jar

# Switch to non-root user — required by CONTROL: RN-09.
USER appuser

# Expose the application port.
# CONTROL: RN-05 — health probes are available at /actuator/health (port 8080).
EXPOSE 8080

# JVM flags:
#   -XX:+UseContainerSupport          — respect cgroup CPU/memory limits
#   -XX:MaxRAMPercentage=75.0         — cap heap at 75% of container memory
#   -XX:+ExitOnOutOfMemoryError       — fast-fail on OOM instead of limping
#   -Djava.security.egd=file:/dev/./urandom — faster entropy (non-blocking)
#   -Dspring.profiles.active=prod     — activate the production Spring profile
#
# Override at runtime with:
#   docker run -e JAVA_OPTS="-Xms256m -Xmx512m" securemicro/tmpl-rest-api
ENTRYPOINT ["java", \
    "-XX:+UseContainerSupport", \
    "-XX:MaxRAMPercentage=75.0", \
    "-XX:+ExitOnOutOfMemoryError", \
    "-Djava.security.egd=file:/dev/./urandom", \
    "-jar", "/app/app.jar"]
