# =============================================================================
# reference-deploy/.env.example
#
# WARNING: DEV MODE ONLY — NOT FOR PRODUCTION
#
# This file documents all environment variables consumed by docker-compose.yml.
# Copy it to .env and adjust values as needed for your local setup.
# The .gitignore at the repo root ensures .env is NEVER committed.
#
# All default values shown here are dev placeholders suitable ONLY for local
# development with Docker Compose.  They provide no real security.
#
# CONTROL: RN-01 — this file contains zero real secrets; all values are
#   placeholders documented for developer convenience.
# =============================================================================

# ---------------------------------------------------------------------------
# Keycloak admin credentials
#
# Used by: keycloak service (docker-compose.yml)
# WARNING: DEV MODE ONLY — replace with strong credentials in any shared env.
# CONTROL: RN-01 — placeholder; not a real credential.
# ---------------------------------------------------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
# WARNING: DEV MODE ONLY
KC_BOOTSTRAP_ADMIN_PASSWORD=dev-placeholder-not-for-production

# ---------------------------------------------------------------------------
# HashiCorp Vault — dev mode root token
#
# Used by: vault service and tmpl-rest-api service (docker-compose.yml)
# WARNING: DEV MODE ONLY — the root token is the Vault dev-mode default.
#   Never use this token outside of a local development environment.
# CONTROL: RN-01 — placeholder; not a production secret.
# ---------------------------------------------------------------------------
# WARNING: DEV MODE ONLY — Vault root token
VAULT_DEV_ROOT_TOKEN_ID=root
VAULT_TOKEN=root

# ---------------------------------------------------------------------------
# Vault address
#
# Used by: tmpl-rest-api service (docker-compose.yml) and vault-dev-init.sh
# Points to the vault container by Docker service name when running inside
# the Compose network, or to localhost:8200 when running the init script
# from the host.
# ---------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200

# ---------------------------------------------------------------------------
# Keycloak issuer URI — consumed by tmpl-rest-api
#
# AC INI-06: KEYCLOAK_ISSUER_URI is read from env var — never hardcoded.
# Format: http://<keycloak-host>:<port>/realms/<realm-name>
# In Docker Compose, the keycloak service is reachable by its service name.
#
# CONTROL: RN-01 — this is configuration, not a secret; safe to commit as example.
# CONTROL: RN-02 — wires the service JWT validation to the local Keycloak realm.
# ---------------------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://keycloak:8080/realms/tmpl-rest-api

# ---------------------------------------------------------------------------
# JWT audience
#
# Must match the "aud" claim in tokens issued by Keycloak for the tmpl-rest-api
# client.  Default value aligns with the reference realm name.
# ---------------------------------------------------------------------------
JWT_AUDIENCE=tmpl-rest-api

# ---------------------------------------------------------------------------
# OpenTelemetry exporter endpoint
#
# Points to the Jaeger OTLP gRPC collector.
# CONTROL: INI-19 — W3C TraceContext propagation to the Jaeger collector.
# CONTROL: INI-21 — service starts normally even if Jaeger is unreachable.
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=tmpl-rest-api
OTEL_TRACES_EXPORTER=otlp
